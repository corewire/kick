{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":semanticCommitsDisabled"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "bin/**",
    "dist/**",
    "docs/public/**",
    "docs/resources/**",
    "ai-docs/**"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^(?:hack|test|config|examples)/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Go toolchain version: the 'go' directive in go.mod and docs/go.mod and the Dockerfile builder image must move together. Renovate does not bump the directive by default, so opt in.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "rangeStrategy": "bump",
      "groupName": "go version",
      "groupSlug": "go-version",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Go toolchain version: Dockerfile builder image, grouped with the go.mod directives above.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "golang"
      ],
      "groupName": "go version",
      "groupSlug": "go-version",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Enable all indirect Go module updates, including transitive security fixes.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
      "groupName": "go indirect modules"
    },
    {
      "description": "Kubernetes API/controller-runtime modules must stay mutually compatible.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime"
      ],
      "groupName": "kubernetes go modules"
    },
    {
      "description": "OpenTelemetry modules move together.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/**"
      ],
      "groupName": "opentelemetry go modules"
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "Third-party control planes the e2e suite installs. Each is a separate PR so a failing e2e run points at one component.",
      "matchManagers": [
        "custom.regex",
        "kubernetes"
      ],
      "matchFileNames": [
        "test/e2e/setup/**"
      ],
      "additionalBranchPrefix": "e2e-"
    },
    {
      "description": "KICK's own image is a release artifact, not a dependency; never propose updates for it.",
      "matchPackageNames": [
        "ghcr.io/corewire/kick",
        "controller"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hack/tool-versions\\.mk$/"],
      "matchStrings": ["ENVTEST_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "sigs.k8s.io/controller-runtime/tools/setup-envtest",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hack/tool-versions\\.mk$/"],
      "matchStrings": ["ENVTEST_K8S_VERSION \\?= (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "kubernetes-sigs/controller-tools",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^envtest-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hack/tool-versions\\.mk$/"],
      "matchStrings": ["KAMERA_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/tgoodwin/kamera",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hack/tool-versions\\.mk$/"],
      "matchStrings": ["HELM_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hack/tool-versions\\.mk$/"],
      "matchStrings": ["ACTIONLINT_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/rhysd/actionlint",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(?:hack|test|tools|internal)/.*\\.(?:sh|py|go)$/"],
      "matchStrings": ["[iI]mage:\\s*\"?(?<depName>[a-z0-9./_-]+):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "sigs.k8s.io/kustomize/kustomize/v5 pinned in hack/tool-versions.mk.",
      "managerFilePatterns": [
        "/^hack/tool-versions\\.mk$/"
      ],
      "matchStrings": [
        "KUSTOMIZE_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "sigs.k8s.io/kustomize/kustomize/v5",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "sigs.k8s.io/controller-tools/cmd/controller-gen pinned in hack/tool-versions.mk.",
      "managerFilePatterns": [
        "/^hack/tool-versions\\.mk$/"
      ],
      "matchStrings": [
        "CONTROLLER_TOOLS_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "sigs.k8s.io/controller-tools",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "github.com/golangci/golangci-lint/v2/cmd/golangci-lint pinned in hack/tool-versions.mk.",
      "managerFilePatterns": [
        "/^hack/tool-versions\\.mk$/"
      ],
      "matchStrings": [
        "GOLANGCI_LINT_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/golangci/golangci-lint/v2",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "github.com/kyverno/chainsaw pinned in hack/tool-versions.mk.",
      "managerFilePatterns": [
        "/^hack/tool-versions\\.mk$/"
      ],
      "matchStrings": [
        "CHAINSAW_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/kyverno/chainsaw",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "golang.org/x/vuln/cmd/govulncheck pinned in hack/tool-versions.mk.",
      "managerFilePatterns": [
        "/^hack/tool-versions\\.mk$/"
      ],
      "matchStrings": [
        "GOVULNCHECK_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "kubernetes-sigs/kind pinned in hack/tool-versions.mk.",
      "managerFilePatterns": [
        "/^hack/tool-versions\\.mk$/"
      ],
      "matchStrings": [
        "KIND_VERSION \\?= (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Hugo version used to build the docs site.",
      "managerFilePatterns": [
        "/^\\.github/workflows/docs-pages\\.yml$/"
      ],
      "matchStrings": [
        "hugo-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Argo CD version used to install the control plane for e2e scenarios.",
      "managerFilePatterns": [
        "/^test/e2e/setup/argocd/install-argocd\\.sh$/"
      ],
      "matchStrings": [
        "ARGOCD_VERSION=\"\\$\\{ARGOCD_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Argo Rollouts version used to install the controller for e2e scenarios.",
      "managerFilePatterns": [
        "/^test/e2e/setup/rollouts/install-rollouts\\.sh$/"
      ],
      "matchStrings": [
        "ROLLOUTS_VERSION=\"\\$\\{ROLLOUTS_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "argoproj/argo-rollouts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Kargo control plane chart version used for e2e scenarios.",
      "managerFilePatterns": [
        "/^test/e2e/setup/kargo/install-kargo\\.sh$/"
      ],
      "matchStrings": [
        "KARGO_VERSION=\"\\$\\{KARGO_VERSION:-(?<currentValue>[\\d.]+)\\}\""
      ],
      "depNameTemplate": "ghcr.io/akuity/kargo-charts/kargo",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "cert-manager version required by the Kargo e2e setup.",
      "managerFilePatterns": [
        "/^test/e2e/setup/kargo/install-kargo\\.sh$/"
      ],
      "matchStrings": [
        "CERT_MANAGER_VERSION=\"\\$\\{CERT_MANAGER_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "cert-manager/cert-manager",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Secrets Store CSI driver Helm chart version used for e2e scenarios.",
      "managerFilePatterns": [
        "/^test/e2e/setup/csi/install-csi\\.sh$/"
      ],
      "matchStrings": [
        "CSI_DRIVER_VERSION=\"\\$\\{CSI_DRIVER_VERSION:-(?<currentValue>[\\d.]+)\\}\""
      ],
      "depNameTemplate": "secrets-store-csi-driver",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://kubernetes-sigs.github.io/secrets-store-csi-driver/charts"
    },
    {
      "customType": "regex",
      "description": "OpenBao CSI provider version used for e2e scenarios.",
      "managerFilePatterns": [
        "/^test/e2e/setup/csi/install-csi\\.sh$/"
      ],
      "matchStrings": [
        "CSI_PROVIDER_VERSION=\"\\$\\{CSI_PROVIDER_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\}\""
      ],
      "depNameTemplate": "openbao/openbao-csi-provider",
      "datasourceTemplate": "github-tags"
    }
  ]
}
