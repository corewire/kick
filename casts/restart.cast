{"version": 2, "width": 92, "height": 24, "timestamp": 1786350617, "idle_time_limit": 8.0, "env": {}}
[0.006448, "o", "# A Deployment consumes web-secret via envFrom. It is running and stable.\r\n"]
[1.511511, "o", "$ kubectl -n kick-demo get deploy web\r\n"]
[2.584912, "o", "NAME   READY   UP-TO-DATE   AVAILABLE   AGE\r\nweb    1/1     1            1           10s\r\n"]
[4.593634, "o", "\r\n# Rotate the Secret. Kubernetes alone would NOT restart the Pod.\r\n"]
[6.098191, "o", "$ kubectl -n kick-demo patch secret web-secret -p API_TOKEN=bravo\r\n"]
[7.179468, "o", "secret/web-secret patched\r\n"]
[9.270321, "o", "\r\n# KICK stamped kubectl.kubernetes.io/restartedAt on the Pod template:\r\n"]
[10.774745, "o", "$ kubectl -n kick-demo get deploy web -o jsonpath=\"{...restartedAt}\"\r\n"]
[11.845715, "o", "2026-08-10T08:30:24Z"]
[11.850636, "o", "\r\n"]
[13.855153, "o", "# So the Deployment rolls out fresh Pods:\r\n"]
[15.359089, "o", "$ kubectl -n kick-demo rollout status deploy/web\r\n"]
[16.435777, "o", "deployment \"web\" successfully rolled out\r\n"]
[21.445974, "o", "\r\n"]
