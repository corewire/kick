        === COMMAND
        /usr/bin/sh -c set -eu
        deadline=$(( $(date +%s) + 150 ))
        while true; do
          phase=$(kubectl -n kick-e2e-058 get kickrequest deployment-app \
            -o jsonpath='{.status.phase}' 2>/dev/null || true)
          if [ "$phase" = "Succeeded" ]; then
            break
          fi
          case "$phase" in
            Failed|DryRun)
              echo "unexpected terminal phase '${phase}' without a GitOps provider" >&2
              kubectl -n kick-e2e-058 get kickrequests -o yaml >&2 || true
              exit 1
              ;;
          esac
          if [ "$(date +%s)" -ge "$deadline" ]; then
            echo "expected the kickrequest to succeed, got '${phase}'" >&2
            kubectl -n kick-e2e-058 get kickrequests -o yaml >&2 || true
            exit 1
          fi
          sleep 2
        done
