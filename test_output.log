        === COMMAND
        /usr/bin/sh -c set -eu
        restarted=$(kubectl -n kick-e2e-058 get deployment app \
          -o jsonpath='{.spec.template.metadata.annotations.kubectl\.kubernetes\.io/restartedAt}')
        if [ -z "${restarted}" ]; then
          echo "expected restartedAt to be set" >&2
          exit 1
        fi
        # Ownership was never resolved, so no gate may have been recorded
        # as blocking.
        provider=$(kubectl -n kick-e2e-058 get kickrequest deployment-app \
          -o jsonpath='{.status.owner.provider}' || true)
        if [ -n "${provider}" ] && [ "${provider}" != "none" ]; then
          echo "expected no GitOps owner, got '${provider}'" >&2
          exit 1
        fi
        # Let the system settle, then require the state to be stable: a
        # single rollout, and no second KickRequest.
        sleep 30
        settled=$(kubectl -n kick-e2e-058 get deployment app \
          -o jsonpath='{.spec.template.metadata.annotations.kubectl\.kubernetes\.io/restartedAt}')
        if [ "${settled}" != "${restarted}" ]; then
          echo "expected exactly one restart, restartedAt changed from '${restarted}' to '${settled}'" >&2
          exit 1
        fi
        revisions=$(kubectl -n kick-e2e-058 get replicaset \
          -l app=app --no-headers | wc -l | tr -d ' ')
        if [ "${revisions}" != "2" ]; then
          echo "expected exactly 2 replicasets (initial + one restart), got ${revisions}" >&2
          kubectl -n kick-e2e-058 get replicaset -o wide >&2 || true
          exit 1
        fi
