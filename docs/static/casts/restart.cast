{"version": 2, "width": 92, "height": 24, "timestamp": 1786348428, "env": {}}
[0.007851, "o", "# A Deployment consumes web-secret via envFrom. It is running and stable.\r\n$ kubectl --context kind-kick-dev -n kick-demo get deploy web\r\n"]
[0.072972, "o", "NAME   READY   UP-TO-DATE   AVAILABLE   AGE\r\nweb    1/1     1            1           8s\r\n"]
[3.083923, "o", "\r\n"]
[3.083978, "o", "# Rotate the Secret. Kubernetes alone would NOT restart the Pod.\r\n"]
[3.084198, "o", "$ kubectl --context kind-kick-dev -n kick-demo patch secret web-secret --type merge -p API_TOKEN=bravo\r\n"]
[3.16745, "o", "secret/web-secret patched\r\n"]
[8.177468, "o", "\r\n# KICK noticed the change and stamped a fresh rollout:\r\n"]
[8.177507, "o", "$ kubectl --context kind-kick-dev -n kick-demo get deploy web -o jsonpath restartedAt\r\n"]
[8.239368, "o", "2026-08-10T07:53:51Z"]
[8.245376, "o", "\r\n"]
[9.250714, "o", "$ kubectl --context kind-kick-dev -n kick-demo rollout status deploy/web\r\n"]
[9.319898, "o", "deployment \"web\" successfully rolled out\r\n"]
[12.330461, "o", "\r\n"]
