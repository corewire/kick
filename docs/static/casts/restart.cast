{"version": 2, "width": 92, "height": 24, "timestamp": 1786349341, "idle_time_limit": 2.0, "env": {}}
[0.006278, "o", "# A Deployment consumes web-secret via envFrom. It is running and stable.\r\n"]
[2.009868, "o", "$ kubectl -n kick-demo get deploy web\r\n"]
[3.069504, "o", "NAME   READY   UP-TO-DATE   AVAILABLE   AGE\r\nweb    1/1     1            1           11s\r\n"]
[6.07799, "o", "\r\n# Rotate the Secret. Kubernetes alone would NOT restart the Pod.\r\n"]
[8.083231, "o", "$ kubectl -n kick-demo patch secret web-secret -p API_TOKEN=bravo\r\n"]
[9.157259, "o", "secret/web-secret patched\r\n"]
[13.165586, "o", "\r\n# KICK stamped kubectl.kubernetes.io/restartedAt and the Deployment rolled out:\r\n"]
[15.172709, "o", "$ kubectl -n kick-demo rollout status deploy/web\r\n"]
[16.237647, "o", "deployment \"web\" successfully rolled out\r\n"]
[19.246472, "o", "\r\n# Exactly one KickRequest handled it — watch it settle Succeeded:\r\n"]
[21.253296, "o", "$ kubectl -n kick-demo get kickrequests -w\r\n"]
[22.315148, "o", "NAME             PHASE               TARGET   PROVIDER   OWNER   REASON    AGE\r\ndeployment-web   WaitingForRollout   web                         Allowed   13s\r\n"]
[39.365828, "o", "deployment-web   Executing           web                         Allowed   30s\r\n"]
[39.371431, "o", "deployment-web   Succeeded           web                         Allowed   30s\r\n"]
[49.102134, "o", "\r\n"]
